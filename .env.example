# Deployment/tooling template. Do not use this file as a catch-all application .env.
# Use services/api/.env.example for server provider credentials and
# apps/mobile/.env.example for Flutter build-time public configuration.
# This file must never contain provider API keys.
OPENLOOP_API_BASE_URL=http://127.0.0.1:8000

# AWS resource references used by local emulators or deployment tooling.
AWS_REGION=ap-northeast-2
OPENLOOP_TABLE_NAME=
OPENLOOP_DEFAULT_USER_ID=dev-local
OPENLOOP_REQUIRE_INSTALL_ID=false
INTEGRATION_SECRET_ARN=
GEMINI_MODEL=gemini-3.5-flash-lite
FCM_SECRET_ARN=
FCM_PROJECT_ID=
POSTHOG_HOST=

# Local-only direct values. Leave empty until credentials are issued.
# AWS deployments load these keys from INTEGRATION_SECRET_ARN instead.
GEMINI_API_KEY=
KAKAO_REST_API_KEY=
KMA_AUTH_KEY=
POSTHOG_PROJECT_API_KEY=
SENTRY_DSN=

# Store real provider credentials in AWS Secrets Manager and pass only the ARN.
