# Versioned template only. Copy to the ignored .env file and enter real values there.
# Never put direct values in this file, the Flutter application, logs, or chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
KAKAO_REST_API_KEY=
KMA_AUTH_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# AWS uses one JSON SecretString containing the direct environment variable
# names above. Direct environment values still take precedence.
INTEGRATION_SECRET_ARN=
FCM_SECRET_ARN=
FCM_PROJECT_ID=
OPENLOOP_LIVE_ACTIVITY_ENABLED=false

# Require a UUID X-OpenLoop-Install-Id header in production.
OPENLOOP_REQUIRE_INSTALL_ID=false
OPENLOOP_DEFAULT_USER_ID=dev-local
