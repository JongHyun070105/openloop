# Flutter build-time configuration only. Copy to the ignored apps/mobile/.env.
# Never put Gemini, Kakao, KMA, Firebase service-account, or AWS credentials here.
OPENLOOP_API_BASE_URL=https://mrodt7pxq4.execute-api.ap-northeast-2.amazonaws.com/dev

# PostHog project API keys and Sentry DSNs are public client identifiers, not server secrets.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# Firebase client configuration; all four values are required before push is enabled.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
